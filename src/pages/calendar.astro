---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import EventList from '../components/EventList.astro';
import FinalCta from '../components/FinalCta.astro';
import { config } from '../config';
---
<Base title="Calendar · Călătorul Antreprenor">
  <main>
    <PageHead kicker="Calendar" title="Întâlniri live," em="în ora ta locală." sub="Webinarii și workshop-uri pe Zoom. Înscrierea și detaliile sunt în platformă." />
    <section class="section">
      <div class="wrap stack">
        <EventList limit={10} />
      </div>
    </section>
    <FinalCta href={config.links.calendar} label="Deschide calendarul" title="Ne vedem" em="joi, la 19:00." />
  </main>
</Base>
