---
/* The top of every inner page: a band of sky with the title in the middle (the nav is white over it). */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props { kicker: string; title: string; em: string; sub?: string; image?: ImageMetadata }
const { kicker, title, em, sub, image } = Astro.props;
---
<header class="ph">
  {image ? <Image class="ph-img" src={image} alt="" widths={[960, 1600, 2200]} sizes="100vw" loading="eager" /> : <img class="ph-img ph-sky" src="/hero/clouds.webp" alt="" width="1600" height="2400" />}
  <div class="wrap stack">
    <p class="kicker label">{kicker}</p>
    <h1 class="h1" data-split>{title} <em>{em}</em></h1>
    {sub && <p class="lead">{sub}</p>}
  </div>
</header>

<style is:global>
  .ph { position: relative; display: grid; place-items: center; min-height: 72vh; padding-block: 140px 90px; overflow: hidden; color: #fff; background: #2D5A7C; }
  .ph-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .ph-sky { object-position: 50% 45%; animation: drift 40s var(--ease-inout) infinite alternate; }
  @keyframes drift { from { transform: scale(1.08) translateX(-1.5%); } to { transform: scale(1.08) translateX(1.5%); } }
  .ph::before { content: ""; position: absolute; inset: 0; z-index: 1; background: linear-gradient(rgba(16, 52, 96, .5), rgba(16, 52, 96, .25) 60%, rgba(16, 52, 96, .45)); }
  .ph .wrap { position: relative; z-index: 2; }
  .ph .kicker { color: #fff; }
  .ph h1 { text-shadow: 0 4px 40px rgba(8, 28, 48, .45); }
  .ph .lead { color: rgba(255, 255, 255, .92); }
</style>
