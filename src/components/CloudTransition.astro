---
/* Between pages you fly through a cloud: it rises over the page (0.6s), the next page is swapped in
   behind it, and it carries on upwards (0.8s). It survives the swap (transition:persist). */
---
<div class="cloud-pass" transition:persist="cloud-pass" aria-hidden="true">
  <img src="/hero/clouds.webp" alt="" width="1600" height="2400" decoding="async" />
</div>

<style is:global>
  .cloud-pass { position: fixed; inset: -10vh 0; z-index: 100; pointer-events: none; visibility: hidden; }
  .cloud-pass img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 70%; }
  /* soft white edges, so it reads as cloud and not as a picture sliding past */
  .cloud-pass::before { content: ""; position: absolute; inset: 0; z-index: 1; background: linear-gradient(transparent, rgba(255, 255, 255, .85) 18%, rgba(255, 255, 255, .55) 50%, rgba(255, 255, 255, .85) 82%, transparent); }
  /* the native cross-fade would fight the cloud */
  ::view-transition-old(root), ::view-transition-new(root) { animation: none; }
</style>

<script>
  import { $ } from '../scripts/motion';
  import { initCloudPass } from '../scripts/transition';
  initCloudPass($('.cloud-pass')!);
</script>
