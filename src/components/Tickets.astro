---
/* Upcoming group trips as boarding passes (home shows 3, /excursii all of them). */
import { getCollection, getEntry } from 'astro:content';
import { Image } from 'astro:assets';

interface Props { limit?: number }
const now = new Date();
const trips = await Promise.all(
  (await getCollection('trips'))
    .filter((t) => t.data.start >= now)
    .sort((a, b) => +a.data.start - +b.data.start)
    .slice(0, Astro.props.limit ?? 99)
    .map(async (t) => ({ ...t.data, dest: (await getEntry(t.data.destination))! })),
);
---
<ul class="tickets">
  {trips.map((t) => (
    <li class="ticket" data-reveal>
      <a href={`/destinatii/${t.dest.id}`}>
        <Image class="ticket-img" src={t.dest.data.image} alt="" width={480} />
        <span class="ticket-body">
          <span class="label ticket-kind">Bilet de grup · Călătorul Antreprenor</span>
          <span class="h3">{t.dest.data.name}</span>
          <span class="ticket-country">{t.dest.data.country}</span>
          <span class="ticket-dates">{t.dates}</span>
          <span class="ticket-sum">{t.summary}</span>
        </span>
      </a>
    </li>
  ))}
</ul>

<style is:global>
  .tickets { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 22px; margin-top: 52px !important; }
  .ticket { overflow: hidden; border: 1px solid var(--line); border-radius: var(--radius-lg); background: var(--card); text-align: center; transition: border-color .4s, transform .6s var(--ease-out); }
  .ticket:hover { border-color: var(--accent-ink); transform: translateY(-4px); }
  .ticket a { display: block; }
  .ticket-img { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; }
  /* the tear line of a boarding pass */
  .ticket-body { position: relative; display: grid; gap: 4px; padding: 30px 24px 28px; border-top: 2px dashed var(--line); }
  .ticket-body::before, .ticket-body::after { content: ""; position: absolute; top: -11px; width: 20px; height: 20px; border-radius: 50%; background: var(--bg); border: 1px solid var(--line); }
  .ticket-body::before { left: -11px; } .ticket-body::after { right: -11px; }
  .ticket-kind { color: var(--accent-ink); font-size: 10px; }
  .ticket .h3 { margin-top: 8px; }
  .ticket-country { color: var(--muted); font-size: 14px; }
  .ticket-dates { margin-top: 10px; font-weight: 600; font-variant-numeric: tabular-nums; }
  .ticket-sum { margin-top: 6px; color: var(--muted); font-size: 14px; }
</style>
