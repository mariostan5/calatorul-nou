---
import { config } from '../config';

interface Props { href?: string; label?: string; title?: string; em?: string }
const { href = config.links.club, label = 'Urcă la bord', title = 'Locul tău e', em = 'lângă hublou.' } = Astro.props;
---
<section class="final">
  <img class="final-sky" src="/hero/clouds.webp" alt="" loading="lazy" width="1600" height="2400" />
  <div class="wrap stack">
    <h2 class="h2" data-split>{title} <em>{em}</em></h2>
    <p class="lead">Joi, la 19:00, ora României, îți arătăm pe Zoom cum funcționează clubul. Gratuit, fără obligații.</p>
    <p class="actions" data-reveal>
      <a class="btn btn-primary" href={href}>{label}</a>
      <a class="btn btn-ghost" href={config.links.calendar}>Vezi calendarul</a>
    </p>
  </div>
</section>

<style is:global>
  .final { position: relative; overflow: hidden; padding-block: clamp(140px, 22vh, 260px); color: #fff; background: #2D5A7C; }
  .final-sky { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 40%; }
  .final::before { content: ""; position: absolute; inset: 0; z-index: 1; background: linear-gradient(rgba(16, 52, 96, .55), rgba(16, 52, 96, .2)); }
  .final .wrap { position: relative; z-index: 2; }
  .final .lead { color: rgba(255, 255, 255, .9); }
  .final .btn-ghost { color: #fff; border-color: #fff; }
  .final .btn-ghost:hover { background: #fff; color: #0A0A0A; }
</style>
