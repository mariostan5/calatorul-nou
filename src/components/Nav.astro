---
import { config } from '../config';

const left = [['Destinații', '/destinatii'], ['Travorium', '/travorium'], ['Excursii', '/excursii']] as const;
const right = [['Calendar', '/calendar'], ['Academie', '/academie'], ['Comunitate', '/comunitate']] as const;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const cur = (href: string) => (path === href || path.startsWith(href + '/') ? 'page' : undefined);
---
<header class="nav" data-nav>
  <nav class="nav-side nav-left" aria-label="Meniu">
    {left.map(([t, href]) => <a href={href} aria-current={cur(href)}>{t}</a>)}
  </nav>
  <a class="nav-logo" href="/" aria-label="Călătorul Antreprenor, acasă">
    <img src="/brand-logo.webp" alt="" width="240" height="240" />
  </a>
  <div class="nav-side nav-right">
    <nav aria-label="Meniu, continuare">{right.map(([t, href]) => <a href={href} aria-current={cur(href)}>{t}</a>)}</nav>
    <a class="btn btn-primary nav-cta" href={config.links.club}>Intră în club</a>
  </div>
  <button class="nav-burger" type="button" aria-expanded="false" aria-controls="nav-menu" aria-label="Deschide meniul"><i></i><i></i></button>
  <div class="nav-menu" id="nav-menu" hidden>
    {[...left, ...right].map(([t, href]) => <a href={href} aria-current={cur(href)}>{t}</a>)}
    <a class="btn btn-primary" href={config.links.club}>Intră în club</a>
  </div>
</header>

<style is:global>
  .nav { position: fixed; inset: 0 0 auto; z-index: 50; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 24px; padding: 14px var(--pad); color: #fff; transition: background-color .5s, color .5s, box-shadow .5s; }
  .nav.solid { background: color-mix(in srgb, var(--bg) 88%, transparent); color: var(--fg); box-shadow: 0 1px 0 var(--line); -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px); }
  .nav-side { display: flex; align-items: center; gap: clamp(18px, 2.2vw, 36px); }
  .nav-side nav { display: contents; }
  .nav-left { justify-content: flex-end; }
  .nav-right { justify-content: flex-start; }
  .nav-side a:not(.btn) { position: relative; font-size: 14px; font-weight: 500; letter-spacing: .02em; }
  .nav-side a:not(.btn)::after { content: ""; position: absolute; left: 0; right: 0; bottom: -4px; height: 2px; background: var(--accent); transform: scaleX(0); transition: transform .5s var(--ease-out); }
  .nav-side a:not(.btn):hover::after, .nav-side a[aria-current]::after { transform: scaleX(1); }
  .nav-logo img { width: 52px; height: 52px; border-radius: 50%; box-shadow: 0 4px 18px rgba(17, 80, 137, .25); }
  .nav-cta { margin-left: auto; padding: 11px 18px; }
  .nav-burger, .nav-menu { display: none; }
  @media (max-width: 1100px) {
    .nav-side { display: none; }
    .nav-burger { display: grid; gap: 6px; justify-self: end; grid-column: 3; padding: 12px; background: none; border: 0; cursor: pointer; }
    .nav-burger i { width: 24px; height: 2px; background: currentColor; transition: transform .4s var(--ease-out); }
    .nav-burger[aria-expanded='true'] i:first-child { transform: translateY(4px) rotate(45deg); }
    .nav-burger[aria-expanded='true'] i:last-child { transform: translateY(-4px) rotate(-45deg); }
    .nav-logo { grid-column: 2; }
    .nav-menu:not([hidden]) { display: flex; position: fixed; inset: 0; z-index: -1; flex-direction: column; align-items: center; justify-content: center; gap: 22px; background: var(--bg); color: var(--fg); font-family: var(--display); font-size: 34px; }
  }
</style>

<script>
  import { onPage, $ } from '../scripts/motion';
  onPage(() => {
    const nav = $('[data-nav]')!, burger = $('.nav-burger', nav)!, menu = $('.nav-menu', nav)!;
    // over the sky the menu is white; once the page moves it gets a light background
    const solid = () => nav.classList.toggle('solid', scrollY > 40 || !menu.hidden);
    const toggle = () => { menu.hidden = !menu.hidden; burger.setAttribute('aria-expanded', String(!menu.hidden)); solid(); };
    solid();
    addEventListener('scroll', solid, { passive: true });
    burger.addEventListener('click', toggle);
    return () => removeEventListener('scroll', solid);
  });
</script>
