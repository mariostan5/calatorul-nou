---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const list = (await getCollection('destinations')).sort((a, b) => a.data.order - b.data.order);
---
<section class="section dest" id="destinatii">
  <div class="wrap stack">
    <p class="kicker label">Destinații</p>
    <h2 class="h2" data-split>Unde ai putea să vii <em>cu noi.</em></h2>
    <p class="lead" data-reveal>Hoteluri de 4–5★ la prețuri de membru, în peste 2.000 de destinații. Iată câteva dintre cele în care comunitatea a fost deja.</p>
  </div>
  <div class="dest-viewport" data-reveal>
    <ul class="dest-track" data-drag>
      {list.map((d) => (
        <li>
          <a class="dest-card" href={`/destinatii/${d.id}`} draggable="false">
            <Image src={d.data.image} alt={`${d.data.name}, ${d.data.country}`} widths={[420, 720]} sizes="360px" draggable="false" />
            <span class="dest-meta">
              <span class="h3">{d.data.name}</span>
              <span class="dest-country">{d.data.country}</span>
              <span class="dest-price label">prețuri de membru</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
  <p class="dest-hint label" aria-hidden="true">← Trage →</p>
  <p class="actions"><a class="btn btn-ghost" href="/destinatii">Toate destinațiile</a></p>
</section>

<style is:global>
  .dest .wrap { margin-bottom: 56px; }
  .dest-viewport { overflow: hidden; padding-inline: max(var(--pad), calc((100vw - 1200px) / 2)); cursor: grab; }
  .dest-viewport:active { cursor: grabbing; }
  .dest-track { display: flex; gap: 22px; width: max-content; touch-action: pan-y; }
  .dest-card { position: relative; display: block; width: 360px; aspect-ratio: 3 / 4; overflow: hidden; border-radius: var(--radius-lg); background: var(--card-2); user-select: none; }
  .dest-card img { width: 100%; height: 100%; object-fit: cover; transition: transform 1s var(--ease-out); pointer-events: none; }
  .dest-card:hover img { transform: scale(1.05); }
  .dest-card::after { content: ""; position: absolute; inset: 0; background: linear-gradient(transparent 45%, rgba(8, 28, 48, .78)); }
  .dest-meta { position: absolute; z-index: 1; inset: auto 0 0; display: grid; justify-items: center; gap: 4px; padding: 26px; color: #fff; text-align: center; }
  .dest-country { font-size: 14px; opacity: .85; }
  .dest-price { margin-top: 10px; padding: 6px 10px; border-radius: 99px; background: var(--accent); color: #0A0A0A; font-size: 11px; }
  .dest-hint { margin-top: 26px; text-align: center; color: var(--muted); }
  .dest .actions { margin-top: 18px; }
</style>

<script>
  import { onPage, $ } from '../../scripts/motion';
  import { initDragCarousel } from '../../scripts/drag-carousel';
  onPage(() => {
    const track = $('.dest-track[data-drag]');
    if (track) return initDragCarousel(track);
  });
</script>
